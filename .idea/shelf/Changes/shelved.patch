+package com.gymowner.controller;
+
+import com.gymowner.config.ApiException;
+import com.gymowner.dto.Dtos.CheckInRequest;
+import com.gymowner.model.Attendance;
+import com.gymowner.model.Member;
+import com.gymowner.repo.AttendanceRepository;
+import com.gymowner.repo.MemberRepository;
+import jakarta.validation.Valid;
+import java.time.LocalDate;
+import java.time.LocalTime;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import org.springframework.http.HttpStatus;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.*;
+
+@RestController
+@RequestMapping("/api/attendance")
+public class AttendanceController {
+    private final AttendanceRepository attendance;
+    private final MemberRepository members;
+
+    public AttendanceController(AttendanceRepository attendance, MemberRepository members) {
+        this.attendance = attendance;
+        this.members = members;
+    }
+
+    @GetMapping("/today")
+    public List<Attendance> today() {
+        return attendance.findByCheckInDateOrderByIdDesc(LocalDate.now());
+    }
+
+    @PostMapping("/checkin")
+    @Transactional
+    public Map<String, Object> checkIn(@Valid @RequestBody CheckInRequest r) {
+        String id = r.identifier().trim();
+        Member m = members.findByMemberCode(id.toUpperCase())
+                .or(() -> members.findByPhone(id))
+                .orElseThrow(() -> new ApiException(HttpStatus.NOT_FOUND, "No member found for \"" + id + "\""));
+        boolean already = attendance.existsByMemberIdAndCheckInDate(m.id, LocalDate.now());
+        if (!already) {
+            Attendance a = new Attendance();
+            a.member = m;
+            a.checkInDate = LocalDate.now();
+            a.checkInTime = LocalTime.now().withNano(0);
+            attendance.save(a);
+        }
+        Map<String, Object> res = new LinkedHashMap<>();
+        res.put("member", m);
+        res.put("alreadyCheckedIn", already);
+        res.put("expired", "EXPIRED".equals(m.getStatus()));
+        return res;
+    }
+}
