+package com.gymowner.controller;
+
+import com.gymowner.config.ApiException;
+import com.gymowner.config.TokenStore;
+import com.gymowner.dto.Dtos.LoginRequest;
+import com.gymowner.dto.Dtos.PasswordChange;
+import com.gymowner.model.Owner;
+import com.gymowner.repo.OwnerRepository;
+import jakarta.validation.Valid;
+import java.util.Map;
+import org.springframework.http.HttpStatus;
+import org.springframework.security.crypto.bcrypt.BCryptPasswordEncoder;
+import org.springframework.web.bind.annotation.*;
+
+@RestController
+@RequestMapping("/api/auth")
+public class AuthController {
+    private final OwnerRepository owners;
+    private final TokenStore tokens;
+    private final BCryptPasswordEncoder encoder = new BCryptPasswordEncoder();
+
+    public AuthController(OwnerRepository owners, TokenStore tokens) {
+        this.owners = owners;
+        this.tokens = tokens;
+    }
+
+    @PostMapping("/login")
+    public Map<String, Object> login(@Valid @RequestBody LoginRequest r) {
+        Owner o = owners.findByUsername(r.username().trim())
+                .filter(x -> encoder.matches(r.password(), x.passwordHash))
+                .orElseThrow(() -> new ApiException(HttpStatus.UNAUTHORIZED, "Wrong username or password"));
+        return Map.of("token", tokens.issue(o.username), "name", o.fullName == null ? o.username : o.fullName);
+    }
+
+    @PostMapping("/change-password")
+    public Map<String, String> changePassword(@RequestAttribute("owner") String username, @Valid @RequestBody PasswordChange r) {
+        Owner o = owners.findByUsername(username).orElseThrow(() -> new ApiException(HttpStatus.UNAUTHORIZED, "Please log in again"));
+        if (!encoder.matches(r.oldPassword(), o.passwordHash)) {
+            throw new ApiException(HttpStatus.BAD_REQUEST, "Current password is wrong");
+        }
+        o.passwordHash = encoder.encode(r.newPassword());
+        owners.save(o);
+        return Map.of("message", "Password changed");
+    }
+}
