+package com.gymowner.config;
+
+import com.gymowner.model.Owner;
+import com.gymowner.model.Plan;
+import com.gymowner.repo.OwnerRepository;
+import com.gymowner.repo.PlanRepository;
+import com.gymowner.service.SettingService;
+import java.math.BigDecimal;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.boot.CommandLineRunner;
+import org.springframework.security.crypto.bcrypt.BCryptPasswordEncoder;
+import org.springframework.stereotype.Component;
+
+@Component
+public class DataSeeder implements CommandLineRunner {
+    private final OwnerRepository owners;
+    private final PlanRepository plans;
+    private final SettingService settings;
+    @Value("${app.owner.username}") String username;
+    @Value("${app.owner.password}") String password;
+    @Value("${app.owner.name}") String ownerName;
+    @Value("${app.owner.phone}") String ownerPhone;
+
+    public DataSeeder(OwnerRepository owners, PlanRepository plans, SettingService settings) {
+        this.owners = owners;
+        this.plans = plans;
+        this.settings = settings;
+    }
+
+    @Override
+    public void run(String... args) {
+        if (owners.count() == 0) {
+            Owner o = new Owner();
+            o.username = username;
+            o.passwordHash = new BCryptPasswordEncoder().encode(password);
+            o.fullName = ownerName;
+            owners.save(o);
+        }
+        if (plans.count() == 0) {
+            plan("Monthly", 1, "1000", "0", "");
+            plan("Quarterly", 3, "3000", "10", "Save 10%");
+            plan("Half-yearly", 6, "6000", "15", "Save 15%");
+            plan("Yearly", 12, "12000", "25", "Best value - save 25%");
+        }
+        settings.setIfAbsent("gymName", "My Fitness Club");
+        settings.setIfAbsent("gymAddress", "Your gym address, City");
+        settings.setIfAbsent("gymEmail", "");
+        settings.setIfAbsent("billingNumber", ownerPhone);
+        settings.setIfAbsent("ownerPhone", ownerPhone);
+        settings.setIfAbsent("terms",
+                "Membership fees are non-refundable and non-transferable.\n"
+              + "Members must carry their Member ID and follow gym rules.\n"
+              + "Use equipment with care; damage may be charged.\n"
+              + "Management is not responsible for loss of personal belongings.\n"
+              + "Members with medical conditions must consult a doctor before training.");
+    }
+
+    private void plan(String name, int months, String price, String disc, String note) {
+        Plan p = new Plan();
+        p.name = name;
+        p.durationMonths = months;
+        p.price = new BigDecimal(price);
+        p.discountPercent = new BigDecimal(disc);
+        p.offerNote = note;
+        plans.save(p);
+    }
+}
