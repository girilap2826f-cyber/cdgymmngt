+package com.gymowner.service;
+
+import com.google.zxing.BarcodeFormat;
+import com.google.zxing.client.j2se.MatrixToImageWriter;
+import com.google.zxing.common.BitMatrix;
+import com.google.zxing.qrcode.QRCodeWriter;
+import com.gymowner.config.ApiException;
+import com.gymowner.model.Member;
+import com.gymowner.model.Payment;
+import com.gymowner.repo.PaymentRepository;
+import com.lowagie.text.Document;
+import com.lowagie.text.Element;
+import com.lowagie.text.Font;
+import com.lowagie.text.FontFactory;
+import com.lowagie.text.Image;
+import com.lowagie.text.PageSize;
+import com.lowagie.text.Paragraph;
+import com.lowagie.text.Phrase;
+import com.lowagie.text.Rectangle;
+import com.lowagie.text.pdf.PdfPCell;
+import com.lowagie.text.pdf.PdfPTable;
+import com.lowagie.text.pdf.PdfWriter;
+import java.awt.Color;
+import java.io.ByteArrayOutputStream;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+import java.time.LocalDate;
+import java.time.format.DateTimeFormatter;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.http.HttpStatus;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+/** One layout for both the joining confirmation and renewal / due receipts. */
+@Service
+public class PdfService {
+    private static final DateTimeFormatter FMT = DateTimeFormatter.ofPattern("dd MMM yyyy");
+    private static final Color INK = new Color(31, 42, 48);
+    private static final Color MUTED = new Color(107, 119, 125);
+
+    private final SettingService settings;
+    private final PaymentRepository payments;
+    @Value("${app.data-dir:./data}") String dataDir;
+
+    public PdfService(SettingService settings, PaymentRepository payments) {
+        this.settings = settings;
+        this.payments = payments;
+    }
+
+    /** Membership confirmation for a member (original registration payment; falls back to latest payment). */
+    @Transactional(readOnly = true)
+    public byte[] forMember(Long memberId) {
+        Payment p = payments.findFirstByMemberIdAndKindOrderByIdAsc(memberId, Payment.Kind.REGISTRATION)
+                .or(() -> payments.findFirstByMemberIdOrderByIdDesc(memberId))
+                .orElseThrow(() -> new ApiException(HttpStatus.NOT_FOUND, "No payment record found for this member"));
+        return build(p);
+    }
+
+    @Transactional(readOnly = true)
+    public byte[] forPayment(Long paymentId) {
+        Payment p = payments.findById(paymentId).orElseThrow(() -> new ApiException(HttpStatus.NOT_FOUND, "Payment not found"));
+        return build(p);
+    }
+
+    private byte[] build(Payment p) {
+        try {
+            Member m = p.member;
+            boolean registration = p.kind == Payment.Kind.REGISTRATION;
+            Font gym = FontFactory.getFont(FontFactory.HELVETICA_BOLD, 20, INK);
+            Font h2 = FontFactory.getFont(FontFactory.HELVETICA_BOLD, 13, INK);
+            Font small = FontFactory.getFont(FontFactory.HELVETICA, 9, MUTED);
+
+            Document doc = new Document(PageSize.A4, 40, 40, 40, 40);
+            ByteArrayOutputStream out = new ByteArrayOutputStream();
+            PdfWriter.getInstance(doc, out);
+            doc.open();
+
+            // ---- header: logo + gym name ----
+            PdfPTable head = new PdfPTable(new float[]{1f, 5f});
+            head.setWidthPercentage(100);
+            PdfPCell logoCell = new PdfPCell();
+            logoCell.setBorder(Rectangle.NO_BORDER);
+            Path logo = Paths.get(dataDir, "logo.img");
+            if (Files.exists(logo)) {
+                try {
+                    Image img = Image.getInstance(Files.readAllBytes(logo));
+                    img.scaleToFit(64, 64);
+                    logoCell.addElement(img);
+                } catch (Exception ignored) { /* bad logo file: skip it */ }
+            }
+            head.addCell(logoCell);
+            PdfPCell nameCell = new PdfPCell();
+            nameCell.setBorder(Rectangle.NO_BORDER);
+            nameCell.addElement(new Paragraph(settings.get("gymName"), gym));
+            nameCell.addElement(new Paragraph(settings.get("gymAddress"), small));
+            nameCell.addElement(new Paragraph("Billing / contact: " + settings.get("billingNumber"), small));
+            head.addCell(nameCell);
+            doc.add(head);
+
+            Paragraph title = new Paragraph(registration ? "MEMBERSHIP CONFIRMATION" : "PAYMENT RECEIPT", h2);
+            title.setAlignment(Element.ALIGN_CENTER);
+            title.setSpacingBefore(16);
+            title.setSpacingAfter(12);
+            doc.add(title);
+
+            // ---- details + photo + QR ----
+            PdfPTable details = new PdfPTable(new float[]{1.3f, 2f});
+            details.setWidthPercentage(100);
+            row(details, "Member ID", m.memberCode);
+            row(details, "Name", m.fullName);
+            row(details, "Contact number", m.phone);
+            row(details, "Plan", p.planName);
+            row(details, "Start date", date(p.periodStart));
+            row(details, "Expiry date", date(p.periodEnd));
+            row(details, "Amount paid", "Rs. " + p.amount);
+            row(details, "Payment mode", p.mode == null ? "-" : p.mode.name());
+            row(details, "Balance due", "Rs. " + p.balanceAfter);
+            row(details, "Receipt no.", p.receiptNo);
+            row(details, "Date", date(p.paymentDate));
+
+            PdfPTable outer = new PdfPTable(new float[]{3f, 1.2f});
+            outer.setWidthPercentage(100);
+            PdfPCell left = new PdfPCell(details);
+            left.setBorder(Rectangle.NO_BORDER);
+            outer.addCell(left);
+
+            PdfPCell right = new PdfPCell();
+            right.setBorder(Rectangle.NO_BORDER);
+            if (m.isHasPhoto()) {
+                try {
+                    Image ph = Image.getInstance(m.photo);
+                    ph.scaleToFit(100, 125);
+                    ph.setAlignment(Element.ALIGN_CENTER);
+                    right.addElement(ph);
+                } catch (Exception ignored) { /* unreadable photo: skip */ }
+            }
+            right.addElement(new Paragraph(" "));
+            Image qr = Image.getInstance(qrPng(m.memberCode));
+            qr.scaleToFit(90, 90);
+            qr.setAlignment(Element.ALIGN_CENTER);
+            right.addElement(qr);
+            outer.addCell(right);
+            doc.add(outer);
+
+            // ---- terms ----
+            Paragraph tHead = new Paragraph("Terms & conditions", h2);
+            tHead.setSpacingBefore(16);
+            tHead.setSpacingAfter(4);
+            doc.add(tHead);
+            for (String line : settings.get("terms").split("\\r?\\n")) {
+                if (!line.isBlank()) doc.add(new Paragraph("- " + line.trim(), small));
+            }
+
+            // ---- signature ----
+            PdfPTable sig = new PdfPTable(new float[]{3f, 1f, 3f});
+            sig.setWidthPercentage(100);
+            sig.setSpacingBefore(56);
+            sig.addCell(sigCell("Owner signature / stamp", small));
+            PdfPCell gap = new PdfPCell(new Phrase(""));
+            gap.setBorder(Rectangle.NO_BORDER);
+            sig.addCell(gap);
+            sig.addCell(sigCell("Date: " + LocalDate.now().format(FMT), small));
+            doc.add(sig);
+
+            Paragraph foot = new Paragraph("This is a computer-generated document.", small);
+            foot.setAlignment(Element.ALIGN_CENTER);
+            foot.setSpacingBefore(24);
+            doc.add(foot);
+
+            doc.close();
+            return out.toByteArray();
+        } catch (ApiException e) {
+            throw e;
+        } catch (Exception e) {
+            throw new ApiException(HttpStatus.INTERNAL_SERVER_ERROR, "PDF generation failed: " + e.getMessage());
+        }
+    }
+
+    private void row(PdfPTable t, String label, String value) {
+        PdfPCell a = new PdfPCell(new Phrase(label, FontFactory.getFont(FontFactory.HELVETICA, 10, MUTED)));
+        PdfPCell b = new PdfPCell(new Phrase(value == null || value.isBlank() ? "-" : value, FontFactory.getFont(FontFactory.HELVETICA_BOLD, 10, INK)));
+        for (PdfPCell c : new PdfPCell[]{a, b}) {
+            c.setBorder(Rectangle.BOTTOM);
+            c.setBorderColor(new Color(225, 229, 227));
+            c.setPadding(5);
+            t.addCell(c);
+        }
+    }
+
+    private PdfPCell sigCell(String text, Font f) {
+        PdfPCell c = new PdfPCell(new Phrase(text, f));
+        c.setBorder(Rectangle.TOP);
+        c.setPaddingTop(4);
+        return c;
+    }
+
+    private byte[] qrPng(String text) throws Exception {
+        BitMatrix bm = new QRCodeWriter().encode(text == null ? "-" : text, BarcodeFormat.QR_CODE, 220, 220);
+        ByteArrayOutputStream o = new ByteArrayOutputStream();
+        MatrixToImageWriter.writeToStream(bm, "PNG", o);
+        return o.toByteArray();
+    }
+
+    private String date(LocalDate d) { return d == null ? "-" : d.format(FMT); }
+}
