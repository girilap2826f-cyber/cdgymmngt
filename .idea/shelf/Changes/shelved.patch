+        BigDecimal d = discountPercent == null ? BigDecimal.ZERO : discountPercent;
+        return price.multiply(BigDecimal.valueOf(100).subtract(d))
+                .divide(BigDecimal.valueOf(100), 2, RoundingMode.HALF_UP);
+    }
+}
