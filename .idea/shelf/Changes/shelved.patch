+package com.gymowner.service;
+
+import com.gymowner.config.ApiException;
+import com.gymowner.model.Setting;
+import com.gymowner.repo.SettingRepository;
+import java.security.SecureRandom;
+import java.time.Instant;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.http.HttpStatus;
+import org.springframework.stereotype.Service;
+
+@Service
+public class SettingService {
+    /** Keys the owner can edit freely. billingNumber is deliberately NOT here - it needs an OTP. */
+    private static final List<String> EDITABLE = List.of("gymName", "gymAddress", "gymEmail", "terms");
+
+    private static class Otp {
+        final String code;
+        final Instant created = Instant.now();
+        final Instant expires;
+        int attempts = 0;
+        Otp(String code, Instant expires) { this.code = code; this.expires = expires; }
+    }
+
+    private final SettingRepository repo;
+    private final SmsGateway sms;
+    private final SecureRandom random = new SecureRandom();
+    private volatile Otp pending;
+
+    @Value("${app.otp.dev-mode:false}") boolean devMode;
+    @Value("${app.otp.validity-minutes:5}") long validityMinutes;
+
+    public SettingService(SettingRepository repo, SmsGateway sms) {
+        this.repo = repo;
+        this.sms = sms;
+    }
+
+    public String get(String key) {
+        return repo.findById(key).map(s -> s.value == null ? "" : s.value).orElse("");
+    }
+
+    public void set(String key, String value) {
+        Setting s = repo.findById(key).orElseGet(Setting::new);
+        s.key = key;
+        s.value = value == null ? "" : value.trim();
+        repo.save(s);
+    }
+
+    public void setIfAbsent(String key, String value) {
+        if (!repo.existsById(key)) set(key, value);
+    }
+
+    public Map<String, String> all() {
+        Map<String, String> m = new LinkedHashMap<>();
+        repo.findAll().forEach(s -> {
+            if (!"ownerPhone".equals(s.key)) m.put(s.key, s.value);
+        });
+        m.put("ownerPhoneMasked", mask(get("ownerPhone")));
+        return m;
+    }
+
+    public void update(Map<String, String> in) {
+        for (String k : EDITABLE) {
+            if (in.containsKey(k)) set(k, in.get(k));
+        }
+    }
+
+    // ---------------- OTP-protected billing number ----------------
+    public synchronized Map<String, Object> requestBillingOtp() {
+        if (pending != null && Instant.now().isBefore(pending.created.plusSeconds(30))) {
+            throw new ApiException(HttpStatus.TOO_MANY_REQUESTS, "Please wait 30 seconds before requesting another OTP");
+        }
+        String code = String.format("%06d", random.nextInt(1_000_000));
+        pending = new Otp(code, Instant.now().plusSeconds(validityMinutes * 60));
+        String phone = get("ownerPhone");
+        sms.send(phone, "Your OTP to change the gym billing number is " + code + ". Valid for " + validityMinutes + " minutes. Do not share it.");
+        Map<String, Object> r = new LinkedHashMap<>();
+        r.put("message", "OTP sent to " + mask(phone));
+        if (devMode) r.put("devOtp", code);
+        return r;
+    }
+
+    public synchronized void changeBillingNumber(String newNumber, String otp) {
+        String number = newNumber.replaceAll("[\\s-]", "");
+        if (!number.matches("^\\+?[0-9]{10,15}$")) {
+            throw new ApiException(HttpStatus.BAD_REQUEST, "Enter a valid billing number (10 to 15 digits)");
+        }
+        Otp p = pending;
+        if (p == null) throw new ApiException(HttpStatus.BAD_REQUEST, "Request an OTP first");
+        if (Instant.now().isAfter(p.expires)) {
+            pending = null;
+            throw new ApiException(HttpStatus.BAD_REQUEST, "OTP expired. Request a new one");
+        }
+        if (!p.code.equals(otp.trim())) {
+            p.attempts++;
+            if (p.attempts >= 3) {
+                pending = null;
+                throw new ApiException(HttpStatus.FORBIDDEN, "Too many wrong attempts. Request a new OTP");
+            }
+            throw new ApiException(HttpStatus.BAD_REQUEST, "Wrong OTP. " + (3 - p.attempts) + " attempt(s) left");
+        }
+        pending = null;
+        set("billingNumber", number);
+    }
+
+    private String mask(String phone) {
+        if (phone == null || phone.length() < 4) return "your registered number";
+        return "xxxxxx" + phone.substring(phone.length() - 4);
+    }
+}
