+package com.gymowner.controller;
+
+import com.gymowner.config.ApiException;
+import com.gymowner.dto.Dtos.PlanRequest;
+import com.gymowner.model.Plan;
+import com.gymowner.repo.PlanRepository;
+import jakarta.validation.Valid;
+import java.math.BigDecimal;
+import java.util.List;
+import java.util.Map;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+
+@RestController
+@RequestMapping("/api/plans")
+public class PlanController {
+    private final PlanRepository plans;
+
+    public PlanController(PlanRepository plans) {
+        this.plans = plans;
+    }
+
+    @GetMapping
+    public List<Plan> list() {
+        return plans.findByActiveTrueOrderByDurationMonthsAsc();
+    }
+
+    @PostMapping
+    public Plan create(@Valid @RequestBody PlanRequest r) {
+        return plans.save(apply(new Plan(), r));
+    }
+
+    @PutMapping("/{id}")
+    public Plan update(@PathVariable("id") Long id, @Valid @RequestBody PlanRequest r) {
+        Plan p = plans.findById(id).orElseThrow(() -> new ApiException(HttpStatus.NOT_FOUND, "Plan not found"));
+        return plans.save(apply(p, r));
+    }
+
+    /** Plans are deactivated (not deleted) so old members and receipts keep their plan name. */
+    @DeleteMapping("/{id}")
+    public Map<String, String> remove(@PathVariable("id") Long id) {
+        Plan p = plans.findById(id).orElseThrow(() -> new ApiException(HttpStatus.NOT_FOUND, "Plan not found"));
+        p.active = false;
+        plans.save(p);
+        return Map.of("message", "Plan removed");
+    }
+
+    private Plan apply(Plan p, PlanRequest r) {
+        BigDecimal disc = r.discountPercent() == null ? BigDecimal.ZERO : r.discountPercent();
+        if (r.price().signum() < 0) throw new ApiException(HttpStatus.BAD_REQUEST, "Price cannot be negative");
+        if (disc.signum() < 0 || disc.compareTo(BigDecimal.valueOf(100)) > 0) {
+            throw new ApiException(HttpStatus.BAD_REQUEST, "Discount must be between 0 and 100");
+        }
+        p.name = r.name().trim();
+        p.durationMonths = r.durationMonths();
+        p.price = r.price();
+        p.discountPercent = disc;
+        p.offerNote = r.offerNote() == null ? null : r.offerNote().trim();
+        return p;
+    }
+}
