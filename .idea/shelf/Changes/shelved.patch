+    @Id @GeneratedValue(strategy = GenerationType.IDENTITY) public Long id;
+    public String memberCode;
+    @Column(nullable = false) public String fullName;
+    @Column(nullable = false, unique = true) public String phone;
+    public String email;
+    public String address;
+    public LocalDate dateOfBirth;
+    public String gender;
+    public String emergencyName;
+    public String emergencyPhone;
+    public String idProof;
+    @Column(length = 1000) public String healthNotes;
+
+    @ManyToOne(fetch = FetchType.EAGER) public Plan plan;
+    public LocalDate joinDate;
+    public LocalDate startDate;
+    public LocalDate expiryDate;
+    @Column(precision = 12, scale = 2) public BigDecimal balanceDue = BigDecimal.ZERO;
+
+    @Lob @JsonIgnore public byte[] photo;
+    @JsonIgnore public String photoType;
+    public LocalDateTime createdAt = LocalDateTime.now();
+
+    public String getStatus() {
+        return expiryDate != null && !expiryDate.isBefore(LocalDate.now()) ? "ACTIVE" : "EXPIRED";
+    }
+    public long getDaysLeft() {
+        return expiryDate == null ? 0 : ChronoUnit.DAYS.between(LocalDate.now(), expiryDate);
+    }
+    public boolean isHasPhoto() {
+        return photo != null && photo.length > 0;
+    }
+}
