+package com.gymowner.service;
+
+import com.gymowner.config.ApiException;
+import com.gymowner.dto.Dtos.*;
+import com.gymowner.model.Member;
+import com.gymowner.model.Payment;
+import com.gymowner.model.Plan;
+import com.gymowner.repo.*;
+import java.io.IOException;
+import java.math.BigDecimal;
+import java.time.LocalDate;
+import java.util.List;
+import org.springframework.data.domain.Sort;
+import org.springframework.http.HttpStatus;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.multipart.MultipartFile;
+
+@Service
+public class MemberService {
+    private final MemberRepository members;
+    private final PlanRepository plans;
+    private final PaymentRepository payments;
+    private final AttendanceRepository attendance;
+
+    public MemberService(MemberRepository members, PlanRepository plans, PaymentRepository payments, AttendanceRepository attendance) {
+        this.members = members;
+        this.plans = plans;
+        this.payments = payments;
+        this.attendance = attendance;
+    }
+
+    @Transactional(readOnly = true)
+    public List<Member> list(String q, String status, Long planId) {
+        String s = q == null ? "" : q.trim().toLowerCase();
+        return members.findAll(Sort.by(Sort.Direction.DESC, "id")).stream()
+                .filter(m -> s.isEmpty() || m.fullName.toLowerCase().contains(s) || m.phone.contains(s)
+                        || (m.memberCode != null && m.memberCode.toLowerCase().contains(s)))
+                .filter(m -> status == null || status.isBlank() || m.getStatus().equalsIgnoreCase(status))
+                .filter(m -> planId == null || (m.plan != null && m.plan.id.equals(planId)))
+                .toList();
+    }
+
+    @Transactional(readOnly = true)
+    public List<Member> expiring(int days) {
+        return members.findByExpiryDateLessThanEqualOrderByExpiryDateAsc(LocalDate.now().plusDays(days));
+    }
+
+    @Transactional(readOnly = true)
+    public Member get(Long id) {
+        return members.findById(id).orElseThrow(() -> new ApiException(HttpStatus.NOT_FOUND, "Member not found"));
+    }
+
+    @Transactional
+    public RegistrationResult register(MemberRequest r) {
+        String phone = r.phone().trim();
+        members.findByPhone(phone).ifPresent(m -> {
+            throw new ApiException(HttpStatus.CONFLICT,
+                    "This phone number is already registered to " + m.fullName + " (" + m.memberCode + ")");
+        });
+        Plan plan = plan(r.planId());
+        Member m = new Member();
+        apply(m, r);
+        LocalDate start = r.startDate() != null ? r.startDate() : LocalDate.now();
+        m.plan = plan;
+        m.joinDate = LocalDate.now();
+        m.startDate = start;
+        m.expiryDate = start.plusMonths(plan.durationMonths);
+        BigDecimal paid = nz(r.amountPaid());
+        BigDecimal payable = plan.getPayable();
+        checkPaid(paid, payable);
+        m.balanceDue = payable.subtract(paid);
+        m = members.save(m);
+        m.memberCode = String.format("GYM%04d", m.id);
+        Payment p = record(m, paid, r.paymentMode(), Payment.Kind.REGISTRATION, plan.name, start, m.expiryDate);
+        return new RegistrationResult(m, p);
+    }
+
+    @Transactional
+    public Member update(Long id, MemberRequest r) {
+        Member m = get(id);
+        String phone = r.phone().trim();
+        members.findByPhone(phone).ifPresent(o -> {
+            if (!o.id.equals(id)) {
+                throw new ApiException(HttpStatus.CONFLICT, "This phone number belongs to " + o.fullName + " (" + o.memberCode + ")");
+            }
+        });
+        apply(m, r);
+        return members.save(m);
+    }
+
+    @Transactional
+    public RegistrationResult renew(Long id, RenewRequest r) {
+        Member m = get(id);
+        Plan plan = r.planId() != null ? plan(r.planId()) : m.plan;
+        if (plan == null) throw new ApiException(HttpStatus.BAD_REQUEST, "Choose a plan");
+        LocalDate today = LocalDate.now();
+        // still active -> extend from current expiry, already expired -> start today
+        LocalDate start = (m.expiryDate != null && !m.expiryDate.isBefore(today)) ? m.expiryDate : today;
+        LocalDate expiry = start.plusMonths(plan.durationMonths);
+        BigDecimal paid = nz(r.amountPaid());
+        BigDecimal payable = plan.getPayable();
+        checkPaid(paid, payable);
+        m.plan = plan;
+        m.startDate = start;
+        m.expiryDate = expiry;
+        m.balanceDue = nz(m.balanceDue).add(payable.subtract(paid));
+        members.save(m);
+        Payment p = record(m, paid, r.paymentMode(), Payment.Kind.RENEWAL, plan.name, start, expiry);
+        return new RegistrationResult(m, p);
+    }
+
+    @Transactional
+    public RegistrationResult payDue(Long id, DueRequest r) {
+        Member m = get(id);
+        BigDecimal amt = nz(r.amount());
+        if (amt.signum() <= 0) throw new ApiException(HttpStatus.BAD_REQUEST, "Enter an amount greater than 0");
+        if (amt.compareTo(nz(m.balanceDue)) > 0) throw new ApiException(HttpStatus.BAD_REQUEST, "Amount is more than the pending due (" + m.balanceDue + ")");
+        m.balanceDue = m.balanceDue.subtract(amt);
+        members.save(m);
+        Payment p = record(m, amt, r.paymentMode(), Payment.Kind.DUE_PAYMENT,
+                m.plan != null ? m.plan.name : "-", m.startDate, m.expiryDate);
+        return new RegistrationResult(m, p);
+    }
+
+    @Transactional
+    public void delete(Long id) {
+        get(id);
+        attendance.deleteByMemberId(id);
+        payments.deleteByMemberId(id);
+        members.deleteById(id);
+    }
+
+    @Transactional
+    public void savePhoto(Long id, MultipartFile file) throws IOException {
+        Member m = get(id);
+        String type = file.getContentType();
+        if (type == null || !type.startsWith("image/")) throw new ApiException(HttpStatus.BAD_REQUEST, "Please upload an image file");
+        m.photo = file.getBytes();
+        m.photoType = type;
+        members.save(m);
+    }
+
+    // ---------------- helpers ----------------
+    private Plan plan(Long planId) {
+        if (planId == null) throw new ApiException(HttpStatus.BAD_REQUEST, "Choose a membership plan");
+        return plans.findById(planId).orElseThrow(() -> new ApiException(HttpStatus.BAD_REQUEST, "Plan not found"));
+    }
+
+    private void apply(Member m, MemberRequest r) {
+        m.fullName = r.fullName().trim();
+        m.phone = r.phone().trim();
+        m.email = blank(r.email());
+        m.address = blank(r.address());
+        m.dateOfBirth = r.dateOfBirth();
+        m.gender = blank(r.gender());
+        m.emergencyName = blank(r.emergencyName());
+        m.emergencyPhone = blank(r.emergencyPhone());
+        m.idProof = blank(r.idProof());
+        m.healthNotes = blank(r.healthNotes());
+    }
+
+    private Payment record(Member m, BigDecimal amount, Payment.Mode mode, Payment.Kind kind, String planName, LocalDate ps, LocalDate pe) {
+        Payment p = new Payment();
+        p.member = m;
+        p.amount = amount;
+        p.mode = mode != null ? mode : Payment.Mode.CASH;
+        p.kind = kind;
+        p.paymentDate = LocalDate.now();
+        p.planName = planName;
+        p.periodStart = ps;
+        p.periodEnd = pe;
+        p.balanceAfter = nz(m.balanceDue);
+        p = payments.save(p);
+        p.receiptNo = String.format("RCPT%06d", p.id);
+        return p;
+    }
+
+    private void checkPaid(BigDecimal paid, BigDecimal payable) {
+        if (paid.signum() < 0) throw new ApiException(HttpStatus.BAD_REQUEST, "Amount paid cannot be negative");
+        if (paid.compareTo(payable) > 0) throw new ApiException(HttpStatus.BAD_REQUEST, "Amount paid is more than the plan price (" + payable + ")");
+    }
+
+    private static BigDecimal nz(BigDecimal b) { return b == null ? BigDecimal.ZERO : b; }
+    private static String blank(String s) { return s == null || s.isBlank() ? null : s.trim(); }
+}
