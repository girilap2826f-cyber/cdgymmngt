+    }
+
+    @PostMapping("/logo")
+    public Map<String, String> uploadLogo(@RequestParam("file") MultipartFile file) throws IOException {
+        String type = file.getContentType();
+        if (type == null || !(type.equals("image/png") || type.equals("image/jpeg"))) {
+            throw new ApiException(HttpStatus.BAD_REQUEST, "Logo must be a PNG or JPG image");
+        }
+        Path dir = Paths.get(dataDir);
+        Files.createDirectories(dir);
+        Files.write(dir.resolve("logo.img"), file.getBytes());
+        settings.set("logoType", type);
+        return Map.of("message", "Logo saved");
+    }
+
+    @GetMapping("/logo")
+    public ResponseEntity<byte[]> logo() throws IOException {
+        Path f = Paths.get(dataDir, "logo.img");
+        if (!Files.exists(f)) return ResponseEntity.notFound().build();
+        String type = settings.get("logoType");
+        return ResponseEntity.ok()
+                .contentType(MediaType.parseMediaType(type.isBlank() ? "image/png" : type))
+                .body(Files.readAllBytes(f));
+    }
+}
