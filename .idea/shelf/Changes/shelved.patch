+body{font-family:'Barlow',system-ui,-apple-system,'Segoe UI',sans-serif;color:var(--ink);background:var(--chalk);font-size:15px;line-height:1.45}
+h1,h2,h3{font-family:'Barlow Condensed','Arial Narrow',sans-serif;margin:0;font-weight:600;letter-spacing:.2px}
+.hidden{display:none!important}
+.muted{color:var(--muted)}
+.error{color:var(--red);min-height:20px;font-size:14px}
+button,input,select,textarea{font:inherit;color:inherit}
+:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
+
+/* layout */
+.app{display:flex;min-height:100vh}
+.side{width:230px;background:var(--iron);color:#d7e0e2;display:flex;flex-direction:column;padding:20px 14px;position:sticky;top:0;height:100vh}
+.brand{display:flex;align-items:center;gap:10px;font-family:'Barlow Condensed',sans-serif;font-size:24px;font-weight:700;color:#fff;padding:4px 8px 22px}
+.brand img{width:34px;height:34px;border-radius:8px;object-fit:cover}
+.nav{display:flex;flex-direction:column;gap:2px;flex:1}
+.nav button{background:none;border:0;color:#b9c6c9;text-align:left;padding:10px 12px;border-radius:8px;cursor:pointer;font-weight:500}
+.nav button:hover{background:var(--iron-2);color:#fff}
+.nav button.active{background:var(--accent);color:#fff}
+main{flex:1;padding:28px 34px 60px;max-width:1280px;min-width:0}
+.page-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:20px;flex-wrap:wrap}
+.page-head h2{font-size:34px}
+
+/* surfaces */
+.card{background:var(--plate);border:1px solid var(--line);border-radius:var(--r);padding:18px}
+.card h3{font-size:21px;margin-bottom:12px}
+.grid-2{display:grid;grid-template-columns:1.4fr 1fr;gap:16px;margin-top:16px}
+.tbl{padding:0;overflow-x:auto}
+.toolbar{display:flex;gap:10px;margin-bottom:14px;flex-wrap:wrap;padding:12px}
+.toolbar input{flex:1;min-width:200px}
+
+/* dashboard */
+.hero{display:grid;grid-template-columns:1.2fr 2fr;gap:16px}
+.hero-main{background:var(--iron);color:#fff;border-radius:var(--r);padding:24px;display:flex;flex-direction:column;justify-content:space-between;min-height:190px}
+.hero-main .big{font-family:'Barlow Condensed',sans-serif;font-size:92px;line-height:.9;font-weight:700}
+.hero-main small{color:#a9bbc0;font-size:15px}
+.hero-main .split{display:flex;gap:18px;margin-top:10px;color:#cfdadd}
+.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
+.stat{padding:14px 16px}
+.stat span{color:var(--muted);font-size:14px}
+.stat b{display:block;font-family:'Barlow Condensed',sans-serif;font-size:36px;font-weight:600;line-height:1.1;margin-top:2px}
+.stat.warn b{color:var(--amber)} .stat.bad b{color:var(--red)} .stat.good b{color:var(--green)}
+.bars{display:flex;gap:14px;align-items:flex-end;height:170px}
+.bar-group{flex:1;display:flex;flex-direction:column;align-items:center;height:100%}
+.pair{flex:1;display:flex;align-items:flex-end;gap:4px;width:100%;justify-content:center}
+.pair i{display:block;width:40%;max-width:26px;border-radius:4px 4px 0 0;min-height:2px}
+.pair .r{background:var(--accent)} .pair .e{background:var(--amber)}
+.bar-group em{font-style:normal;font-size:13px;color:var(--muted);margin-top:6px}
+.legend{display:flex;gap:14px;font-size:13px;color:var(--muted);margin-top:8px}
+.legend i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:5px}
+.hbar{margin:8px 0}
+.hbar div.t{display:flex;justify-content:space-between;font-size:14px;margin-bottom:3px}
+.hbar div.b{height:8px;background:var(--chalk);border-radius:6px;overflow:hidden}
+.hbar div.b i{display:block;height:100%;background:var(--accent);border-radius:6px}
+
+/* tables */
+table{width:100%;border-collapse:collapse}
+th{font-weight:500;color:var(--muted);text-align:left;font-size:13.5px;padding:11px 14px;border-bottom:1px solid var(--line);white-space:nowrap}
+td{padding:10px 14px;border-bottom:1px solid var(--line);vertical-align:middle}
+tr:last-child td{border-bottom:0}
+tbody tr:hover{background:#f8faf8}
+td.num,th.num{text-align:right}
+.empty{padding:34px;text-align:center;color:var(--muted)}
+.who{display:flex;align-items:center;gap:10px}
+.who b{display:block;font-weight:600}
+.who small{color:var(--muted)}
+.av{width:38px;height:38px;border-radius:50%;object-fit:cover;flex:none;background:var(--accent-soft);color:var(--accent-d);display:grid;place-items:center;font-weight:600}
+.av.lg{width:92px;height:92px;border-radius:12px;font-size:30px}
+.badge{display:inline-block;padding:2px 10px;border-radius:20px;font-size:13px;font-weight:500}
+.badge.ok{background:var(--green-soft);color:var(--green)} .badge.bad{background:var(--red-soft);color:var(--red)}
+.badge.warn{background:var(--amber-soft);color:var(--amber)} .badge.info{background:var(--accent-soft);color:var(--accent-d)}
+.row-actions{display:flex;gap:6px;justify-content:flex-end;flex-wrap:nowrap}
+
+/* controls */
+input,select,textarea{width:100%;padding:9px 11px;border:1px solid #cdd5d2;border-radius:8px;background:#fff}
+textarea{min-height:90px;resize:vertical}
+label{display:flex;flex-direction:column;gap:5px;font-size:14px;color:var(--muted);font-weight:500}
+.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;border:1px solid #cdd5d2;background:#fff;padding:8px 14px;border-radius:8px;cursor:pointer;font-weight:500;white-space:nowrap}
+.btn:hover{background:#f3f6f4}
+.btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}
+.btn.primary:hover{background:var(--accent-d)}
+.btn.danger{color:var(--red);border-color:#e5b7b0}
+.btn.sm{padding:5px 10px;font-size:13.5px}
+.btn.wide{width:100%;padding:11px}
+.btn.ghost-light{background:transparent;border-color:#46585e;color:#cfdadd}
+.btn.ghost-light:hover{background:var(--iron-2)}
+input[type=file]{padding:6px}
+
+/* forms in modal */
+.modal{position:fixed;inset:0;background:rgba(20,30,34,.55);display:flex;align-items:flex-start;justify-content:center;padding:4vh 16px;overflow:auto;z-index:50}
+.modal-box{background:var(--plate);border-radius:14px;padding:24px;width:100%;max-width:680px;animation:pop .16s ease-out}
+.modal-box.narrow{max-width:460px}
+.modal-box h2{font-size:30px;margin-bottom:14px}
+@keyframes pop{from{transform:translateY(8px);opacity:0}to{transform:none;opacity:1}}
+.fgrid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
+.span2{grid-column:1/-1}
+.actions{display:flex;justify-content:flex-end;gap:10px;margin-top:6px;flex-wrap:wrap}
+.summary{background:var(--accent-soft);border-radius:8px;padding:10px 12px;color:var(--accent-d);font-weight:500}
+.photo-box{display:flex;gap:14px;align-items:center}
+.photo-box video{width:200px;border-radius:8px;display:block;margin-top:8px}
+.kv{display:grid;grid-template-columns:150px 1fr;gap:6px 12px;margin:10px 0}
+.kv dt{color:var(--muted)} .kv dd{margin:0;font-weight:500}
+.profile-head{display:flex;gap:16px;align-items:center;margin-bottom:6px}
+.plan-cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:14px}
+.plan-cards .card b.price{font-family:'Barlow Condensed',sans-serif;font-size:40px;font-weight:600;display:block}
+.plan-cards s{color:var(--muted)}
+.otp-hint{background:var(--amber-soft);color:#7a4e0c;padding:8px 12px;border-radius:8px;font-size:14px}
+
+/* login */
+.login{min-height:100vh;display:grid;place-items:center;background:var(--iron);padding:16px}
+.login-card{background:#fff;border-radius:14px;padding:30px;width:100%;max-width:380px;display:flex;flex-direction:column;gap:12px}
+.login-card h1{font-size:38px}
+
+#toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;gap:8px;z-index:99}
+#toast div{background:var(--iron);color:#fff;padding:11px 18px;border-radius:8px;box-shadow:0 6px 20px rgba(0,0,0,.25)}
+#toast div.err{background:var(--red)}
+
+@media(max-width:900px){
+  .app{flex-direction:column}
+  .side{width:100%;height:auto;position:static;flex-direction:row;flex-wrap:wrap;align-items:center;padding:10px}
+  .brand{padding:0 8px}.nav{flex-direction:row;flex-wrap:wrap;flex-basis:100%;order:3}
+  main{padding:18px 14px 50px}
+  .hero,.grid-2{grid-template-columns:1fr}
+  .stats{grid-template-columns:repeat(2,1fr)}
+  .fgrid{grid-template-columns:1fr}
+}
+@media(prefers-reduced-motion:reduce){.modal-box{animation:none}}
