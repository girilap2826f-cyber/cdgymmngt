+package com.gymowner.service;
+
+import com.gymowner.model.Member;
+import com.gymowner.repo.*;
+import java.math.BigDecimal;
+import java.time.LocalDate;
+import java.time.YearMonth;
+import java.time.format.TextStyle;
+import java.util.*;
+import java.util.stream.Collectors;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+@Service
+public class DashboardService {
+    private final MemberRepository members;
+    private final PaymentRepository payments;
+    private final ExpenseRepository expenses;
+    private final AttendanceRepository attendance;
+
+    public DashboardService(MemberRepository members, PaymentRepository payments, ExpenseRepository expenses, AttendanceRepository attendance) {
+        this.members = members;
+        this.payments = payments;
+        this.expenses = expenses;
+        this.attendance = attendance;
+    }
+
+    @Transactional(readOnly = true)
+    public Map<String, Object> summary() {
+        LocalDate today = LocalDate.now();
+        YearMonth ym = YearMonth.now();
+        long total = members.count();
+        long active = members.countByExpiryDateGreaterThanEqual(today);
+        BigDecimal revenue = nz(payments.sumBetween(ym.atDay(1), ym.atEndOfMonth()));
+        BigDecimal spent = nz(expenses.sumBetween(ym.atDay(1), ym.atEndOfMonth()));
+
+        List<Member> soon = members.findByExpiryDateLessThanEqualOrderByExpiryDateAsc(today.plusDays(7)).stream()
+                .filter(m -> !m.expiryDate.isBefore(today)).toList();
+
+        List<Map<String, Object>> trend = new ArrayList<>();
+        for (int i = 5; i >= 0; i--) {
+            YearMonth t = ym.minusMonths(i);
+            Map<String, Object> row = new LinkedHashMap<>();
+            row.put("month", t.getMonth().getDisplayName(TextStyle.SHORT, Locale.ENGLISH));
+            row.put("revenue", nz(payments.sumBetween(t.atDay(1), t.atEndOfMonth())));
+            row.put("expense", nz(expenses.sumBetween(t.atDay(1), t.atEndOfMonth())));
+            trend.add(row);
+        }
+
+        Map<String, Long> popularity = members.findAll().stream()
+                .filter(m -> m.plan != null)
+                .collect(Collectors.groupingBy(m -> m.plan.name, LinkedHashMap::new, Collectors.counting()));
+
+        Map<String, Object> r = new LinkedHashMap<>();
+        r.put("totalMembers", total);
+        r.put("activeMembers", active);
+        r.put("expiredMembers", total - active);
+        r.put("todayCheckIns", attendance.countByCheckInDate(today));
+        r.put("monthlyRevenue", revenue);
+        r.put("monthlyExpenses", spent);
+        r.put("monthlyProfit", revenue.subtract(spent));
+        r.put("pendingDues", nz(members.totalDue()));
+        r.put("expiringSoonCount", soon.size());
+        r.put("expiringSoon", soon.stream().limit(6).toList());
+        r.put("trend", trend);
+        r.put("planPopularity", popularity);
+        return r;
+    }
+
+    private static BigDecimal nz(BigDecimal b) { return b == null ? BigDecimal.ZERO : b; }
+}
