+package com.gymowner.controller;
+
+import com.gymowner.config.ApiException;
+import com.gymowner.dto.Dtos.ExpenseRequest;
+import com.gymowner.model.Expense;
+import com.gymowner.repo.ExpenseRepository;
+import jakarta.validation.Valid;
+import java.time.LocalDate;
+import java.util.List;
+import java.util.Map;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+
+@RestController
+@RequestMapping("/api/expenses")
+public class ExpenseController {
+    private final ExpenseRepository expenses;
+
+    public ExpenseController(ExpenseRepository expenses) {
+        this.expenses = expenses;
+    }
+
+    @GetMapping
+    public List<Expense> list() {
+        return expenses.findAllByOrderByExpenseDateDescIdDesc();
+    }
+
+    @PostMapping
+    public Expense add(@Valid @RequestBody ExpenseRequest r) {
+        if (r.amount().signum() <= 0) throw new ApiException(HttpStatus.BAD_REQUEST, "Amount must be greater than 0");
+        Expense e = new Expense();
+        e.category = r.category().trim();
+        e.amount = r.amount();
+        e.expenseDate = r.expenseDate() != null ? r.expenseDate() : LocalDate.now();
+        e.note = r.note() == null ? null : r.note().trim();
+        return expenses.save(e);
+    }
+
+    @DeleteMapping("/{id}")
+    public Map<String, String> delete(@PathVariable("id") Long id) {
+        expenses.deleteById(id);
+        return Map.of("message", "Expense deleted");
+    }
+}
