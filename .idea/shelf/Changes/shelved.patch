+package com.gymowner.controller;
+
+import com.gymowner.dto.Dtos.*;
+import com.gymowner.model.Member;
+import com.gymowner.model.Payment;
+import com.gymowner.repo.PaymentRepository;
+import com.gymowner.service.MemberService;
+import com.gymowner.service.PdfService;
+import jakarta.validation.Valid;
+import java.io.IOException;
+import java.util.List;
+import java.util.Map;
+import org.springframework.http.HttpHeaders;
+import org.springframework.http.MediaType;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.*;
+import org.springframework.web.multipart.MultipartFile;
+
+@RestController
+@RequestMapping("/api/members")
+public class MemberController {
+    private final MemberService service;
+    private final PdfService pdf;
+    private final PaymentRepository payments;
+
+    public MemberController(MemberService service, PdfService pdf, PaymentRepository payments) {
+        this.service = service;
+        this.pdf = pdf;
+        this.payments = payments;
+    }
+
+    @GetMapping
+    public List<Member> list(@RequestParam(name = "q", required = false) String q,
+                             @RequestParam(name = "status", required = false) String status,
+                             @RequestParam(name = "planId", required = false) Long planId) {
+        return service.list(q, status, planId);
+    }
+
+    @GetMapping("/expiring")
+    public List<Member> expiring(@RequestParam(name = "days", defaultValue = "7") int days) {
+        return service.expiring(days);
+    }
+
+    @GetMapping("/{id}")
+    public Member get(@PathVariable("id") Long id) {
+        return service.get(id);
+    }
+
+    @PostMapping
+    public RegistrationResult create(@Valid @RequestBody MemberRequest r) {
+        return service.register(r);
+    }
+
+    @PutMapping("/{id}")
+    public Member update(@PathVariable("id") Long id, @Valid @RequestBody MemberRequest r) {
+        return service.update(id, r);
+    }
+
+    @DeleteMapping("/{id}")
+    public Map<String, String> delete(@PathVariable("id") Long id) {
+        service.delete(id);
+        return Map.of("message", "Member deleted");
+    }
+
+    @PostMapping("/{id}/photo")
+    public Map<String, String> uploadPhoto(@PathVariable("id") Long id, @RequestParam("file") MultipartFile file) throws IOException {
+        service.savePhoto(id, file);
+        return Map.of("message", "Photo saved");
+    }
+
+    @GetMapping("/{id}/photo")
+    public ResponseEntity<byte[]> photo(@PathVariable("id") Long id) {
+        Member m = service.get(id);
+        if (!m.isHasPhoto()) return ResponseEntity.notFound().build();
+        return ResponseEntity.ok()
+                .contentType(MediaType.parseMediaType(m.photoType == null ? "image/jpeg" : m.photoType))
+                .header(HttpHeaders.CACHE_CONTROL, "private, max-age=3600")
+                .body(m.photo);
+    }
+
+    /** Re-generate the membership confirmation PDF any time. */
+    @GetMapping("/{id}/pdf")
+    public ResponseEntity<byte[]> confirmation(@PathVariable("id") Long id) {
+        Member m = service.get(id);
+        return pdfResponse(pdf.forMember(id), "membership-" + m.memberCode + ".pdf");
+    }
+
+    @PostMapping("/{id}/renew")
+    public RegistrationResult renew(@PathVariable("id") Long id, @RequestBody RenewRequest r) {
+        return service.renew(id, r);
+    }
+
+    @PostMapping("/{id}/pay-due")
+    public RegistrationResult payDue(@PathVariable("id") Long id, @RequestBody DueRequest r) {
+        return service.payDue(id, r);
+    }
+
+    @GetMapping("/{id}/payments")
+    public List<Payment> history(@PathVariable("id") Long id) {
+        return payments.findByMemberIdOrderByIdDesc(id);
+    }
+
+    static ResponseEntity<byte[]> pdfResponse(byte[] bytes, String name) {
+        return ResponseEntity.ok()
+                .header(HttpHeaders.CONTENT_DISPOSITION, "inline; filename=\"" + name + "\"")
+                .contentType(MediaType.APPLICATION_PDF)
+                .body(bytes);
+    }
+}
