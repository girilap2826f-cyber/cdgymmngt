+        return settings.all();
+    }
+
+    @PostMapping("/billing-number/request-otp")
+    public Map<String, Object> requestOtp() {
+        return settings.requestBillingOtp();
+    }
+
+    @PostMapping("/billing-number/change")
+    public Map<String, String> changeBilling(@Valid @RequestBody BillingChange r) {
+        settings.changeBillingNumber(r.newNumber(), r.otp());
