+package com.gymowner.controller;
+
+import com.gymowner.model.Expense;
+import com.gymowner.model.Member;
+import com.gymowner.model.Payment;
+import com.gymowner.repo.ExpenseRepository;
+import com.gymowner.repo.MemberRepository;
+import com.gymowner.repo.PaymentRepository;
+import java.nio.charset.StandardCharsets;
+import java.util.List;
+import java.util.stream.Collectors;
+import org.springframework.data.domain.Sort;
+import org.springframework.http.HttpHeaders;
+import org.springframework.http.MediaType;
+import org.springframework.http.ResponseEntity;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.*;
+
+/** CSV files open directly in Excel. */
+@RestController
+@RequestMapping("/api/export")
+public class ExportController {
+    private final MemberRepository members;
+    private final PaymentRepository payments;
+    private final ExpenseRepository expenses;
+
+    public ExportController(MemberRepository members, PaymentRepository payments, ExpenseRepository expenses) {
+        this.members = members;
+        this.payments = payments;
+        this.expenses = expenses;
+    }
+
+    @GetMapping("/members.csv")
+    @Transactional(readOnly = true)
+    public ResponseEntity<byte[]> members() {
+        StringBuilder sb = new StringBuilder("Member ID,Name,Phone,Email,Address,Gender,Date of birth,Emergency contact,Emergency phone,Plan,Start,Expiry,Status,Balance due\n");
+        for (Member m : members.findAll(Sort.by("id"))) {
+            sb.append(line(m.memberCode, m.fullName, m.phone, m.email, m.address, m.gender, m.dateOfBirth, m.emergencyName,
+                    m.emergencyPhone, m.plan == null ? "" : m.plan.name, m.startDate, m.expiryDate, m.getStatus(), m.balanceDue));
+        }
+        return csv(sb, "members.csv");
+    }
+
+    @GetMapping("/payments.csv")
+    @Transactional(readOnly = true)
+    public ResponseEntity<byte[]> payments() {
+        StringBuilder sb = new StringBuilder("Receipt,Date,Member ID,Member,Type,Plan,Mode,Amount,Balance after\n");
+        List<Payment> all = payments.findAll(Sort.by(Sort.Direction.DESC, "id"));
+        for (Payment p : all) {
+            sb.append(line(p.receiptNo, p.paymentDate, p.member.memberCode, p.member.fullName, p.kind, p.planName, p.mode, p.amount, p.balanceAfter));
+        }
+        return csv(sb, "payments.csv");
+    }
+
+    @GetMapping("/expenses.csv")
+    public ResponseEntity<byte[]> expenses() {
+        StringBuilder sb = new StringBuilder("Date,Category,Amount,Note\n");
+        for (Expense e : expenses.findAllByOrderByExpenseDateDescIdDesc()) {
+            sb.append(line(e.expenseDate, e.category, e.amount, e.note));
+        }
+        return csv(sb, "expenses.csv");
+    }
+
+    private static String line(Object... cells) {
+        return java.util.Arrays.stream(cells)
+                .map(c -> c == null ? "" : "\"" + c.toString().replace("\"", "\"\"") + "\"")
+                .collect(Collectors.joining(",")) + "\n";
+    }
+
+    private static ResponseEntity<byte[]> csv(StringBuilder sb, String name) {
+        return ResponseEntity.ok()
+                .header(HttpHeaders.CONTENT_DISPOSITION, "attachment; filename=\"" + name + "\"")
+                .contentType(MediaType.parseMediaType("text/csv; charset=UTF-8"))
+                .body(("\uFEFF" + sb).getBytes(StandardCharsets.UTF_8));
+    }
+}
