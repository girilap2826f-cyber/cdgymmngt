+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Gym Owner Manager</title>
+  <link rel="preconnect" href="https://fonts.googleapis.com">
+  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
+  <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600&family=Barlow+Condensed:wght@500;600;700&display=swap" rel="stylesheet">
+  <link rel="stylesheet" href="css/app.css">
+</head>
+<body>
+  <section id="login" class="login hidden">
+    <form id="loginForm" class="login-card">
+      <h1>Gym Owner Manager</h1>
+      <p class="muted">Sign in to manage your members, plans and payments.</p>
+      <label>Username<input id="lu" autocomplete="username" required autofocus></label>
+      <label>Password<input id="lp" type="password" autocomplete="current-password" required></label>
+      <div id="lerr" class="error"></div>
+      <button class="btn primary wide">Sign in</button>
+    </form>
+  </section>
+
+  <div id="app" class="app hidden">
+    <aside class="side">
+      <div class="brand"><img id="brandLogo" alt="" class="hidden"><span id="brandName">Gym</span></div>
+      <nav class="nav" id="nav"></nav>
+      <button class="btn ghost-light" data-act="logout">Sign out</button>
+    </aside>
+    <main id="main"></main>
+  </div>
+
+  <div id="modal" class="modal hidden"><div class="modal-box" id="modalBox"></div></div>
+  <div id="toast"></div>
+  <script src="js/app.js"></script>
